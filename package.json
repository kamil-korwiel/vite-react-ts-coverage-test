{
  "name": "course-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@playwright/test": "^1.50.0",
    "@reduxjs/toolkit": "^2.2.3",
    "axios": "^1.6.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hooks-helper": "^1.6.0",
    "react-loading-skeleton": "^3.4.0",
    "react-lottie-player": "^2.0.0",
    "react-multi-carousel": "^2.8.5",
    "react-redux": "^9.1.1",
    "react-router-dom": "^6.23.0",
    "react-transition-group": "^4.4.5",
    "styled-components": "^5.3.3",
    "typescript": "^5.4.5",
    "use-dark-mode": "^2.3.1"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "serve": "vite preview",
    "test": "playwright test && nyc report",
    "show-coverage": "npx nyc report --reporter=html && start coverage/index.html",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest",
    "chromatic": "chromatic --project-token $CHROMATIC_PROJECT_TOKEN --exit-zero-on-changes --only-changed",
    "prepare": "husky",
    "lint": "eslint --fix .",
    "prettier": "prettier --write .",
    "pre-commit": "lint-staged"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.14.6",
    "@ladle/react": "^4.1.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.12.7",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@types/react-hooks-helper": "^1.6.6",
    "@types/react-redux": "^7.1.33",
    "@types/react-transition-group": "^4.4.10",
    "@types/styled-components": "^5.1.34",
    "@types/testing-library__jest-dom": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/browser": "2.1.2",
    "@vitest/coverage-v8": "2.1.2",
    "babel-loader": "8.1.0",
    "babel-plugin-istanbul": "^6.1.1",
    "babel-plugin-open-source": "^1.3.3",
    "c8": "^7.12.0",
    "chromatic": "^11.12.5",
    "concurrently": "^8.2.2",
    "eslint": "^8.27.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "happy-dom": "^16.7.3",
    "husky": ">=6",
    "istanbul": "^0.4.5",
    "jest-junit": "^16.0.0",
    "lint-staged": ">=10",
    "msw": "^2.2.2",
    "playwright": "^1.50.0",
    "prettier": "^3.2.5",
    "react-is": "^18.3.1",
    "react-test-renderer": "^18.3.1",
    "vite": "^4.0.0",
    "vite-plugin-istanbul": "^4.0.0",
    "vite-plugin-svgr": "^4.2.0",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^2.1.8",
    "vitest-axe": "^0.1.0",
    "vitest-canvas-mock": "^0.3.3",
    "wait-on": "^7.2.0"
  },
  "msw": {
    "workerDirectory": "public"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix",
    "*.{html,md}": "prettier --write"
  },
  "resolutions": {
    "@use-it/event-listener@npm:^0.1.2": "patch:@use-it/event-listener@npm%3A0.1.7#~/.yarn/patches/@use-it-event-listener-npm-0.1.7-56ef42a654.patch"
  }
}
